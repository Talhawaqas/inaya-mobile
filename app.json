{
  "expo": {
    "name": "Inaya Network",
    "slug": "inaya-mobile",
    "scheme": "inayamobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e14"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Inaya Meet uses your camera during video meetings you join.",
        "NSMicrophoneUsageDescription": "Inaya Meet uses your microphone during video meetings you join."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0e14"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.inayanetworksteam.inayamobile",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d3ab3b26-0be8-4082-9f01-45a7b90d8f56"
      }
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Inaya to use Face ID to unlock your Business Workspace."
        }
      ],
      "./plugins/withGradleJvmArgs.js",
      "./plugins/withAdiRegistration.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Inaya to attach photos to the jobs you work on.",
          "cameraPermission": "Allow Inaya to take photos of the jobs you work on."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Inaya to take job photos and scan job and site QR codes.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Inaya records your location only at the moment you start or finish a job, when your company has switched this on. It is never tracked in the background.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d3ab3b26-0be8-4082-9f01-45a7b90d8f56",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
