{
  "expo": {
    "name": "Inaya Network",
    "slug": "inaya-mobile",
    "scheme": "inayamobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a0e14"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0e14"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.inayanetworksteam.inayamobile",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "d3ab3b26-0be8-4082-9f01-45a7b90d8f56"
      }
    },
    "plugins": [
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Inaya to use Face ID to unlock your Business Workspace."
        }
      ],
      "./plugins/withGradleJvmArgs.js",
      "./plugins/withAdiRegistration.js"
    ],
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/d3ab3b26-0be8-4082-9f01-45a7b90d8f56",
      "requestHeaders": {
        "expo-channel-name": "production"
      }
    }
  }
}
